<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Iniciar sesión</h1>

    <p id="mensaje_aviso"><%= mensaje %></p>

    <form id="form_datos_entrada" action="/login" method="POST">

        <section id="campo_de_entrada">
            <p id="encabezado">Nombre de usuario:</p>
            <input type="text" id="nombre_usuario" name="nombre_usuario" required>
            <p id="encabezado">Contraseña:</p>
            <input type="password" id="contrasenia" name="contrasenia" required>
        </section>

        <button type="submit" id="boton_iniciar_sesión">Iniciar sesión</button>
    </form>

    <form action="/register" method="GET">
        <p id="enlace_logregister">¿No tiene cuenta? Registrese <a href="/register">AQUÍ</a></p>
    </form>

</body>
</html>