<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis ejercicios</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Lista de ejercicios</h1>
    <h2>Hola <%= nombreUsuario %></h2>
    
    <%- include('templates/nav') -%>

    <table id="tabla_ejercicios">
        <caption>Ejercicio con el que más calorías se han quemado (Todo el tiempo)</caption>
        <tr>
            <th id="celda_titulo">Tipo</th>
            <th id="celda_titulo">Fecha</th>
            <th id="celda_titulo">Usuario</th>
            <th id="celda_titulo">Calorías</th>
            <th id="celda_titulo">Detalles</th>
        </tr>
        <tr>
    
            <% if (mas_calorias_siempre) { %>
                <tr id="ejercicios">
                    <td><%= mas_calorias_siempre.name %></td>
                    <td><%= mas_calorias_siempre.date %></td>
                    <td><%= mas_calorias_siempre.user %></td>
                    <td><%= mas_calorias_siempre.calories %> cal.</td>
                    <td><a href="/exercises/<%= mas_calorias_siempre.id %>">
                        <p id="ver_ejercicio">Ver ejercicio</p>
                    </a></td>
                </tr>
            <% } else { %>
                <tr>
                    <td></td>
                </tr>
            <% } %> 
                
           
        </tr>
    </table>

    <table id="tabla_ejercicios">
        <caption>Ejercicio con el que más calorías se han quemado (Semanal)</caption>
        <tr>
            <th id="celda_titulo">Tipo</th>
            <th id="celda_titulo">Fecha</th>
            <th id="celda_titulo">Usuario</th>
            <th id="celda_titulo">Calorías</th>
            <th id="celda_titulo">Detalles</th>
        </tr>
        <tr>
           
            <% if (mas_calorias_semana) { %>
                <tr id="ejercicios">
                    <td><%= mas_calorias_semana.name %></td>
                    <td><%= mas_calorias_semana.date %></td>
                    <td><%= mas_calorias_semana.user %></td>
                    <td><%= mas_calorias_semana.calories %> cal.</td>
                    <td><a href="/exercises/<%= mas_calorias_semana.id %>">
                        <p id="ver_ejercicio">Ver ejercicio</p>
                    </a></td>
                </tr>
            <% } else { %>
                <tr>
                    <td></td>
                </tr>
            <% } %>   
                
            
        </tr>
    </table>

    <table id="tabla_ejercicios">
        <caption>Todos mis ejercicios</caption>
        <tr>
            <th id="celda_titulo">Tipo</th>
            <th id="celda_titulo">Fecha</th>
            <th id="celda_titulo">Usuario</th>
            <th id="celda_titulo">Calorías</th>
            <th id="celda_titulo">Detalles</th>
        </tr>
        <tr>
            <% mis_ejercicios.forEach(ejercicio => { %>
                <tr id="ejercicios"ss>
                    <td><%= ejercicio.name %></td>
                    <td><%= ejercicio.date %></td>
                    <td><%= ejercicio.user %></td>
                    <td><%= ejercicio.calories %> cal.</td>
                    <td><a href="/exercises/<%= ejercicio.id %>">
                        <p id="ver_ejercicio">Ver ejercicio</p>
                    </a></td>
                </tr>
            <% }); %>
        </tr>
    </table>

</body>
</html>