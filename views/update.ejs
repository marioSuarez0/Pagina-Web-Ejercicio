<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actualizar ejercicio</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Actualizar ejercicio</h1>
    <h2>Hola <%= perfil.username %></h2>
    
    <%- include('templates/nav_new') -%>

    <form id="form_datos_update" action="/exercises/user" method="POST">
    
        <section id="campo_de_entrada">
            <p id="encabezado">Selecciona un ejercicio:</p>
            <select name="nombre" id="nombre">
                <option value="Running" <% if (ejercicio.name === 'Running') { %> selected <% } %>>Running</option>
                <option value="Caminata" <% if (ejercicio.name === 'Caminata') { %> selected <% } %>>Caminata</option>
                <option value="Natación" <% if (ejercicio.name === 'Natación') { %> selected <% } %>>Natación</option>
                <option value="Ciclismo" <% if (ejercicio.name === 'Ciclismo') { %> selected <% } %>>Ciclismo</option>              
            </select>

            
            <p id="encabezado">Fecha:</p>
            <input type="date" id="fecha" name="fecha" value="<%= ejercicio.date %>" max= <%= fechaMax %>> 
            <p id="encabezado">Tiempo:</p>
            <input type="number" id="tiempo" name="tiempo" value="<%= tiempoEjercicio %>">
        </section>
    
        <button type="submit" id="boton_actualizar">Actualizar ejercicio</button>

        <input type="hidden" id="id_ejercicio" name="id_ejercicio" value="<%= ejercicio.id %>">
    </form>

    <p><a href="/exercises/<%= ejercicio.id %>" id="volver_pagina">Cancelar</a></p>

</body>
</html>